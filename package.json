{
  "name": "idle-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "lint:core": "node scripts/check/core-purity.ts",
    "protect": "node scripts/check/protected.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "node scripts/build.ts",
    "check": "node scripts/check/all.ts",
    "selftest": "node scripts/check/selftest.ts",
    "acceptance": "node scripts/check/acceptance.ts",
    "e2e": "node scripts/build.ts && node tests/e2e/run.ts",
    "e2e-gate": "node scripts/check/e2e-gate.ts",
    "exit": "node scripts/check/exit.ts",
    "status": "node scripts/status.ts",
    "rollback": "node scripts/rollback.ts",
    "play": "node scripts/play.ts",
    "deploy": "node scripts/publish.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
